# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.
# Nothing here is required: without them the Pundit only answers its four canned questions.

# OpenAI API key for "Ask the Pundit" (server only). Mark it Sensitive on Vercel.
OPENAI_API_KEY=
# Optional model override. Default: gpt-5.4-nano with reasoning off.
PUNDIT_MODEL=
# Optional reasoning effort override: none | minimal | low.
PUNDIT_EFFORT=

# Upstash Redis for rate limiting (Vercel KV_REST_API_URL / KV_REST_API_TOKEN also work).
# Required in production for typed questions: without it the daily spend cap can't be enforced
# across serverless instances, so typed questions are switched off (the four canned ones still work).
# Set PUNDIT_ALLOW_MEMORY_LIMITS=1 only on a single long-running server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limits (defaults shown). PUNDIT_DAILY_CAP is the hard cap on questions per day across all visitors.
PUNDIT_PER_MINUTE=3
PUNDIT_PER_DAY=3
PUNDIT_DAILY_CAP=200

# Analytics (optional). Vercel Speed Insights needs no key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Canonical URL for metadata/OG tags, e.g. https://vishalagarwal.dev
NEXT_PUBLIC_SITE_URL=
